{
  "bench_ini": "bench/bench.ini",
  "load_ini": "bench/workloads/load.ini",
  "workload_ini": "bench/workloads/workload_a.ini",
  "base_options_file": "bench/rocksdb_options.ini",
  "memory_limit": "1G",
  "eval_warmup_sec": 180,
  "eval_measure_sec": 60,
  "timeout_sec": 1200,
  "cleanup_db_dir": true,
  "use_checkpoint": false,
  "db_bench_flags": {
    "use_tiered_cache": "true",
    "use_compressed_secondary_cache": "true",
    "cache_size": "256M",
    "compressed_secondary_cache_size": "256M",
    "cache_tier_controller_enabled": "true",
    "cache_tier_controller_warmup_sec": "20",
    "cache_tier_controller_policy_interval_sec": "10",
    "cache_tier_controller_sample_interval_sec": "1"
  },
  "options_overrides": {
    "[TableOptions/BlockBasedTable \"default\"]": {
      "filter_policy": "bloomfilter:10"
    }
  },
  "bench_overrides": {
    "num": "10000000",
    "threads": "16"
  },
  "common_db_bench_flags": {
    "compression_type": "none",
    "histogram": "true"
  }
}
